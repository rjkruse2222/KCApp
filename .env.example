# KCApp Environment Variables
# Copy this file to .env and fill in your values

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Microsoft / Azure AD OAuth
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# Apple Sign In (service ID from Apple Developer Console)
EXPO_PUBLIC_APPLE_SERVICE_ID=com.kcapp.cpa.signin

# Optional: Supabase for cloud sync
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
