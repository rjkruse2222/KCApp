{
  "expo": {
    "name": "KCApp",
    "slug": "kcapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kcapp.cpa",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KCApp needs access to your location to track mileage for business trips.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KCApp needs background location access to automatically track mileage while you drive.",
        "NSLocationAlwaysUsageDescription": "KCApp needs background location access to automatically track mileage while you drive.",
        "UIBackgroundModes": ["location", "fetch"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "package": "com.kcapp.cpa",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "KCApp - CPA Firm Management",
      "shortName": "KCApp",
      "description": "Track time, mileage, and manage clients for your CPA firm",
      "backgroundColor": "#ffffff",
      "themeColor": "#1a365d",
      "lang": "en",
      "output": "single",
      "build": {
        "babel": {
          "include": ["react-native-reanimated"]
        }
      }
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KCApp needs access to your location to track mileage for business trips.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "kcapp"
  }
}
